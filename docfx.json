{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "beryl-template"
    ],
    "globalMetadata": {
      "_appName": "Beryl Engine",
      "_appTitle": "Beryl Engine",
      "_appLogoPath": "images/icon-colored.svg",
      "_enableSearch": true,
      "pdf": false
    },
    "markdownEngineProperties": {
      "alerts": {
        "WIP": "alert alert-wip"
      }
    }
  }
}